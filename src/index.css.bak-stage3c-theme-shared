@import "tailwindcss";
@theme { --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased}*{box-sizing:border-box}body{margin:0;background:#f6f7f9}button,input{font:inherit}button{cursor:pointer}

/* Admin Portal theme preference */
:root {
  color-scheme: light;
}

:root[data-admin-theme="dark"] {
  color-scheme: dark;
}

@media (prefers-color-scheme: dark) {
  :root[data-admin-theme="system"] {
    color-scheme: dark;
  }
}

/* Stage 3C: Admin Portal dark theme */
:root[data-admin-theme="dark"] body {
  background: #0f172a;
  color: #e2e8f0;
}

:root[data-admin-theme="dark"] .bg-white {
  background-color: #1e293b !important;
}

:root[data-admin-theme="dark"] .bg-slate-50 {
  background-color: #0f172a !important;
}

:root[data-admin-theme="dark"] .bg-slate-100 {
  background-color: #334155 !important;
}

:root[data-admin-theme="dark"] .text-slate-900 {
  color: #f8fafc !important;
}

:root[data-admin-theme="dark"] .text-slate-800 {
  color: #f1f5f9 !important;
}

:root[data-admin-theme="dark"] .text-slate-700 {
  color: #e2e8f0 !important;
}

:root[data-admin-theme="dark"] .text-slate-600 {
  color: #cbd5e1 !important;
}

:root[data-admin-theme="dark"] .text-slate-500 {
  color: #94a3b8 !important;
}

:root[data-admin-theme="dark"] .text-slate-400 {
  color: #94a3b8 !important;
}

:root[data-admin-theme="dark"] .border-slate-200 {
  border-color: #334155 !important;
}

:root[data-admin-theme="dark"] .border-slate-300 {
  border-color: #475569 !important;
}

:root[data-admin-theme="dark"] input,
:root[data-admin-theme="dark"] textarea,
:root[data-admin-theme="dark"] select {
  background-color: #1e293b;
  color: #f8fafc;
  border-color: #475569;
}

:root[data-admin-theme="dark"] input::placeholder,
:root[data-admin-theme="dark"] textarea::placeholder {
  color: #94a3b8;
}

:root[data-admin-theme="dark"] .hover\:bg-slate-50:hover {
  background-color: #334155 !important;
}

:root[data-admin-theme="dark"] .hover\:border-slate-400:hover {
  border-color: #64748b !important;
}

