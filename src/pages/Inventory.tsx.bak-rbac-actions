function Field({label,value,onChange,type='text',step}:any){return <div><label className="text-xs font-semibold text-slate-600">{label}</label><input value={value} onChange={e=>onChange(e.target.value)} type={type} step={step} className="mt-1 h-10 w-full rounded-lg border border-slate-200 px-3 text-sm outline-none focus:border-slate-400"/></div>}
function RejectDialog({busy,reason,setReason,onClose,onSubmit}:any){return <Modal title="Reject ingredient" onClose={onClose}><p className="text-sm text-slate-500">A review reason is required and remains part of the authoritative governance record.</p><textarea value={reason} onChange={e=>setReason(e.target.value)} rows={5} className="mt-4 w-full rounded-xl border border-slate-200 p-3 text-sm" placeholder="Explain what must change…"/><div className="mt-4 flex justify-end gap-2"><button onClick={onClose} className="rounded-lg px-4 py-2 text-sm text-slate-600">Cancel</button><button disabled={busy||reason.trim().length<5} onClick={onSubmit} className="rounded-lg bg-rose-700 px-4 py-2 text-sm font-semibold text-white disabled:opacity-40">{busy?'Rejecting…':'Reject ingredient'}</button></div></Modal>}
