export default function Inventory(){const {user}=useAuthStore();const role=user?.role;const canMove=['super_admin','kitchen_operations','procurement'].includes(role||'');const canCreate=canMove;const canReview=['super_admin','nutritionist'].includes(role||'');const [page,setPage]=useState(1),[selected,setSelected]=useState<number|null>(null),[modal,setModal]=useState<'movement'|'create'|'edit'|'reject'|null>(null),[reason,setReason]=useState('');const qc=useQueryClient();const pageSize=useAdminPortalPreferencesStore((state)=>state.preferences?.page_size ?? 25);useEffect(()=>{setPage(1)},[pageSize]);const list=useQuery({queryKey:['inventory-ingredients',page,pageSize],queryFn:()=>listIngredients(page,pageSize)});const detail=useQuery({queryKey:['ingredient',selected],queryFn:()=>getIngredient(selected!),enabled:!!selected});const moves=useQuery({queryKey:['ingredient-movements',selected],queryFn:()=>listMovements(selected!),enabled:!!selected});const mutation=useMutation({mutationFn:async(x:any)=>{switch(x.action){case'movement':return createMovement(x.id,x.payload);case'create':return createIngredient(x.payload);case'update':return updateIngredient(x.id,x.payload);case'approve':return approveIngredient(x.id);case'reject':return rejectIngredient(x.id,x.reason)}},onSuccess:()=>{setModal(null);setReason('');qc.invalidateQueries({queryKey:['inventory-ingredients']});qc.invalidateQueries({queryKey:['ingredient',selected]});qc.invalidateQueries({queryKey:['ingredient-movements',selected]})}});const ingredient=detail.data?.ingredient;return <div className="space-y-6"><header className="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between"><div><div className="mb-2 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-semibold uppercase tracking-[.14em] text-slate-600"><ShieldCheck size={13}/> Food operations</div><h1 className="text-2xl font-semibold tracking-tight text-slate-950">Inventory</h1><p className="mt-1