function MovementForm({ingredient,busy,onClose,onSubmit}:any){const [type,setType]=useState('received'),[qty,setQty]=useState(''),[reason,setReason]=useState('');const positive=type==='received',negative=type==='consumed'||type==='wasted';return <Modal title={`Record movement · ${ingredient.name}`} onClose={onClose}><div className="space-y-4"><div><label className="text-xs font-semibold text-slate-600">Movement type</label><select value={type} onChange={e=>setType(e.target.value)} className="mt-1 h-10 w-full rounded-lg border border-slate-200 px-3 text-sm"><option value="received">Received</option><option value="consumed">Consumed</option><option value="wasted">Wasted</option><option value="adjusted">Adjusted</option></select></div><Field label={`Quantity delta (${ingredient.unit_of_measure})`} value={qty} onChange={setQty} type="number" step="0.001"/><Field label="Reason" value={reason} onChange={setReason}/><div className="rounded-xl border border-amber-100 bg-amber-50 p-3 text-xs leading-5 text-amber-800">Received must increase stock; consumed/wasted must decrease stock. Adjusted may move either direction. Laravel will reject any resulting negative balance.</div><div className="flex justify-end gap-2"><button onClick={onClose} className="rounded-lg px-4 py-2 text-sm text-slate-600">Cancel</button><button disabled={busy||!qty||Number(qty)===0||((positive||negative)&&((positive&&Number(qty)<0)||(negative&&Number(qty)>0)))} onClick={()=>onSubmit({movement_type:type,quantity_delta:Number(qty),reason:reason||undefined})} className="rounded-lg bg-slate-950 px-4 py-2 text-sm font-semibold text-white disabled:opacity-40">{busy?'Recording…':'Record movement'}</button></div></div></Modal>}
