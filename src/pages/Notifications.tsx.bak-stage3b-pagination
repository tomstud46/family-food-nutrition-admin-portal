import {useState} from 'react';
import {useMutation,useQuery,useQueryClient} from '@tanstack/react-query';
import {Bell,Check,CheckCheck,ChevronLeft,ChevronRight,RefreshCw,ShieldCheck} from 'lucide-react';
import {listNotifications,markAllNotificationsRead,markNotificationRead} from '../api/notifications';
import type {Notification} from '../types/notifications';
const errorText=(e:any)=>e?.response?.data?.message||e?.response?.data?.error||Object.values(e?.response?.data?.errors||{})?.flat?.()?.[0]||'The request could not be completed.';
const formatType=(s:string)=>s.replace(/[._-]+/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
const dateText=(s:string)=>new Date(s).toLocaleString();
export default function Notifications(){const [page,setPage]=useState(1),[selected,setSelected]=useState<Notification|null>(null);const qc=useQueryClient();const query=useQuery({queryKey:['notifications',page],queryFn:()=>listNotifications(page)});const read=useMutation({mutationFn:(id:string)=>markNotificationRead(id),onSuccess:(_,id)=>{setSelected(null);qc.invalidateQueries({queryKey:['notifications']});qc.invalidateQueries({queryKey:['notification-unread-count']})}});const all=useMutation({mutationFn:markAllNotificationsRead,onSuccess:()=>{qc.invalidateQueries({queryKey:['notifications']});qc.invalidateQueries({queryKey:['notification-unread-count']})}});return <div className="space-y-6"><header><div className="mb-2 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-semibold uppercase tracking-[.14em] text-slate-600"><Bell size={13}/> System communication</div><div className="flex flex-wrap items-end justify-between gap-4"><div><h1 className="text-2xl font-semibold tracking-tight text-slate-950">Notifications</h1><p className="mt-1 max-w-3xl text-sm leading-6 text-slate-500">Laravel-owned in-app notifications generated after authoritative business operations succeed.</p></div>{query.data&&<div className="rounded-xl border border-slate-200 bg-white px-4 py-2"><div className="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Unread</div><div className="mt-0.5 text-lg font-semibold text-slate-950">{query.data.meta.unread_count}</div></div>}</div></header><section className="overflow-hidden rounded-2xl border border-slate-200 bg-white"><div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 p-4"><div><h2 className="text-sm font-semibold">Notification feed</h2><p className="mt-1 text-xs text-slate-500">Your authenticated account only. Notification IDs cannot be used to access another user's feed.</p></div><div className="flex gap-2"><button onClick={()=>query.refetch()} className="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50"><RefreshCw size={14}/>Refresh</button><button disabled={all.isPending||!query.data?.meta.unread_count} onClick={()=>all.mutate()} className="inline-flex items-center gap-2 rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40"><CheckCheck size={14}/>{all.isPending?'Saving…':'Mark all read'}</button></div></div>{query.isLoading?<Loading/>:query.isError?<ErrorState message={errorText(query.error)}/>:!query.data?.data.length?<Empty/>:<><div className="divide-y divide-slate-100">{query.data.data.map(n=><NotificationRow key={n.id} notification={n} selected={selected?.id===n.id} onSelect={()=>setSelected(n)} onRead={()=>read.mutate(n.id)} busy={read.isPending&&read.variables===n.id}/>)}</div><Pager page={page} last={query.data.meta.last_page} setPage={setPage}/></>}</section>{selected&&<Detail notification={selected} onRead={()=>read.mutate(selected.id)} busy={read.isPending}/>} {read.isError&&<ErrorToast message={errorText(read.error)}/>} {all.isError&&<ErrorToast message={errorText(all.error)}/>}</div>}
function NotificationRow({notification:n,selected,onSelect,onRead,busy}:{notification:Notification;selected:boolean;onSelect:()=>void;onRead:()=>void;busy:boolean}){return <div onClick={onSelect} className={`flex cursor-pointer items-start gap-4 p-5 transition hover:bg-slate-50 ${selected?'bg-slate-50':''} ${!n.read_at?'border-l-2 border-slate-950':''}`}><div className={`mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-xl ${n.read_at?'bg-slate-100 text-slate-400':'bg-slate-950 text-white'}`}><Bell size={16}/></div><div className="min-w-0 flex-1"><div className="flex flex-wrap items-center gap-2"><h3 className="text-sm font-semibold text-slate-900">{n.title||formatType(n.type)}</h3>{!n.read_at&&<span className="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-700">Unread</span>}</div><p className="mt-1 line-clamp-2 text-sm leading-6 text-slate-500">{n.message||'No message provided.'}</p><div className="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-slate-400"><span>{formatType(n.type)}</span><span>{dateText(n.created_at)}</span></div></div>{!n.read_at&&<button onClick={e=>{e.stopPropagation();onRead()}} disabled={busy} className="shrink-0 rounded-lg border border-slate-200 p-2 text-slate-500 hover:bg-white disabled:opacity-40" title="Mark as read"><Check size={15}/></button>}</div>}
function Detail({notification:n,onRead,busy}:{notification:Notification;onRead:()=>void;busy:boolean}){return <section className="rounded-2xl border border-slate-200 bg-white p-5"><div className="flex items-start justify-between gap-4"><div><div className="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-400"><ShieldCheck size={14}/> Notification detail</div><h2 className="mt-2 text-lg font-semibold text-slate-950">{n.title||formatType(n.type)}</h2><p className="mt-1 text-xs text-slate-400">{dateText(n.created_at)} · {formatType(n.type)}</p></div>{!n.read_at&&<button onClick={onRead} disabled={busy} className="inline-flex items-center gap-2 rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white disabled:opacity-40"><Check size={14}/>Mark read</button>}</div><p className="mt-5 max-w-4xl whitespace-pre-wrap text-sm leading-7 text-slate-600">{n.message||'No message provided.'}</p>{Object.keys(n.data).length>0&&<div className="mt-5 rounded-xl border border-slate-200 bg-slate-50 p-4"><div className="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Context</div><pre className="mt-2 overflow-x-auto text-xs leading-5 text-slate-600">{JSON.stringify(n.data,null,2)}</pre></div>}</section>}
function Pager({page,last,setPage}:{page:number;last:number;setPage:(n:number)=>void}){return <div className="flex items-center justify-between border-t border-slate-100 px-5 py-3"><span className="text-xs text-slate-400">Page {page} of {last}</span><div className="flex gap-2"><button disabled={page<=1} onClick={()=>{setPage(page-1)}} className="rounded-lg border p-2 disabled:opacity-30"><ChevronLeft size={15}/></button><button disabled={page>=last} onClick={()=>{setPage(page+1)}} className="rounded-lg border p-2 disabled:opacity-30"><ChevronRight size={15}/></button></div></div>}
function Loading(){return <div className="p-12 text-center text-sm text-slate-400">Loading notifications…</div>};function Empty(){return <div className="p-14 text-center"><Bell className="mx-auto text-slate-300" size={34}/><h2 className="mt-4 text-sm font-semibold text-slate-800">No notifications</h2><p className="mt-1 text-sm text-slate-500">System notifications will appear here after supported business events.</p></div>};function ErrorState({message}:{message:string}){return <div className="p-12 text-center text-sm text-rose-600">{message}</div>};function ErrorToast({message}:{message:string}){return <div className="fixed bottom-5 right-5 z-50 max-w-sm rounded-xl border border-rose-200 bg-white p-4 text-xs text-rose-700 shadow-xl">{message}</div>}
