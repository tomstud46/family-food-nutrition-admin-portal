import {useState} from 'react';
import {useMutation,useQuery,useQueryClient} from '@tanstack/react-query';
import {AlertTriangle,ChevronLeft,ChevronRight,ClipboardList,RefreshCw,ShieldCheck,XCircle} from 'lucide-react';
import {cancelOrder,createOrder,getOrder,listOrders} from '../api/orders';
import {listMeals} from '../api/recipes';
import type {Order} from '../types/orders';
import {useAuthStore} from '../stores/authStore';
const canAct=(r?:string|null)=>['super_admin','nutritionist'].includes(r||'');
const badge=(s:string)=>({pending_payment:'border-amber-100 bg-amber-50 text-amber-700',paid:'border-emerald-100 bg-emerald-50 text-emerald-700',cancelled:'border-slate-200 bg-slate-100 text-slate-500'}[s]||'border-slate-200 bg-white text-slate-600');
const money=(v:any)=>`${Number(v).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})} ETB`;
const err=(e:any)=>e?.response?.data?.message||Object.values(e?.response?.data?.errors||{})?.flat?.()?.[0]||'The request could not be completed.';
export default function Orders(){const {user}=useAuthStore();const qc=useQueryClient();const [customer,setCustomer]=useState('');const [page,setPage]=useState(1);const [selected,setSelected]=useState<number|null>(null);const [reason,setReason]=useState('');const [create,setCreate]=useState(false);const cid=Number(customer);const orders=useQuery({queryKey:['orders',cid,page],queryFn:()=>listOrders(cid,page),enabled:cid>0});const detail=useQuery({queryKey:['order',selected],queryFn:()=>getOrder(selected!),enabled:!!selected});const meals=useQuery({queryKey:['order-meals',cid],queryFn:()=>listMeals(cid,1),enabled:create&&cid>0});const mutation=useMutation({mutationFn:(x:any):Promise<any>=>x.action==='cancel'?cancelOrder(x.id,x.reason):createOrder(cid,x.payload),onSuccess:()=>{qc.invalidateQueries({queryKey:['orders']});qc.invalidateQueries({queryKey:['order',selected]});setCreate(false);setReason('')}});const order=detail.data?.order;return <div className="space-y-6"><header><div className="mb-2 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-semibold uppercase tracking-[.14em] text-slate-600"><ShieldCheck size={13}/> Fulfillment operations</div><div className="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between"><div><h1 className="text-2xl font-semibold tracking-tight text-slate-950">Orders</h1><p className="mt-1 max-w-3xl text-sm leading-6 text-slate-500">Bundle planned meals into an order, monitor payment state, and cancel eligible orders. Payment remains a separate domain.</p></div><button disabled={!cid||!canAct(user?.role)} onClick={()=>setCreate(true)} className="h-10 rounded-lg bg-slate-950 px-4 text-sm font-semibold text-white disabled:opacity-40">Create order</button></div></header><section className="rounded-2xl border border-slate-200 bg-white p-4"><div className="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"><label className="flex-1 text-xs font-semibold text-slate-600">Customer ID<input value={customer} onChange={e=>{setCustomer(e.target.value.replace(/\D/g,''));setPage(1);setSelected(null)}} placeholder="Enter customer ID" inputMode="numeric" className="mt-1 h-10 w-full max-w-sm rounded-lg border border-slate-200 px-3 text-sm"/></label><button onClick={()=>orders.refetch()} disabled={!cid} className="inline-flex h-10 items-center gap-2 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-600 disabled:opacity-40"><RefreshCw size={14}/>Refresh</button></div></section>{!cid?<Empty text="Enter a customer ID to inspect orders."/>:orders.isLoading?<Loading/>:orders.isError?<Error message={err(orders.error)}/>:!orders.data?.data.length?<Empty text="No orders recorded for this customer."/>:<section className="overflow-hidden rounded-2xl border border-slate-200 bg-white"><div className="overflow-x-auto"><table className="w-full min-w-[760px] text-left text-sm"><thead className="bg-slate-50 text-[11px] uppercase tracking-wide text-slate-500"><tr><th className="px-5 py-3">Order</th><th className="px-5 py-3">Meals</th><th className="px-5 py-3">Amount</th><th className="px-5 py-3">Status</th><th className="px-5 py-3 text-right">Action</th></tr></thead><tbody className="divide-y divide-slate-100">{orders.data.data.map(o=><tr key={o.id}><td className="px-5 py-4"><button onClick={()=>setSelected(o.id)} className="font-semibold text-slate-900 hover:underline">Order #{o.id}</button><div className="text-xs text-slate-400">{new Date(o.created_at).toLocaleString()}</div></td><td className="px-5 py-4 text-slate-600">{o.meals.length}</td><td className="px-5 py-4 font-medium">{money(o.total_amount)}</td><td className="px-5 py-4"><span className={`rounded-full border px-2.5 py-1 text-[11px] font-semibold ${badge(o.status)}`}>{o.status}</span></td><td className="px-5 py-4 text-right">{o.status!=='cancelled'&&canAct(user?.role)&&<button onClick={()=>setSelected(o.id)} className="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600">Open</button>}</td></tr>)}</tbody></table></div><Pager page={page} last={orders.data.meta.last_page} setPage={setPage}/></section>}{order&&<OrderDetail order={order} onClose={()=>setSelected(null)} canCancel={canAct(user?.role)&&order.status!=='cancelled'} reason={reason} setReason={setReason} busy={mutation.isPending} onCancel={()=>mutation.mutate({action:'cancel',id:order.id,reason:reason.trim()})}/>} {create&&<CreateOrder customerId={cid} meals={meals.data?.data||[]} loading={meals.isLoading} busy={mutation.isPending} onClose={()=>setCreate(false)} onSubmit={(p:any)=>mutation.mutate({action:'create',payload:p})}/>}</div>}
function OrderDetail({order,onClose,canCancel,reason,setReason,busy,onCancel}:any){return <div className="fixed inset-0 z-50 bg-slate-950/35 p-4"><div className="mx-auto mt-8 max-h-[88vh] max-w-3xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl"><div className="flex items-start justify-between"><div><div className="text-xs font-semibold uppercase tracking-wide text-slate-400">Order #{order.id}</div><h2 className="mt-1 text-xl font-semibold">{money(order.total_amount)}</h2></div><button onClick={onClose} className="rounded-lg p-2 text-slate-400 hover:bg-slate-100">×</button></div><div className="mt-5 grid gap-3 sm:grid-cols-3"><Stat label="Status" value={order.status}/><Stat label="Customer" value={`#${order.customer_id}`}/><Stat label="Created" value={new Date(order.created_at).toLocaleString()}/></div><div className="mt-6"><h3 className="text-sm font-semibold">Meals</h3><div className="mt-2 overflow-hidden rounded-xl border border-slate-200"><table className="w-full text-sm"><tbody className="divide-y divide-slate-100">{order.meals.map((m:any)=><tr key={m.meal_id}><td className="px-4 py-3 font-medium">Meal #{m.meal_id}</td><td className="px-4 py-3 text-slate-500">{m.meal_slot}</td><td className="px-4 py-3 text-slate-500">{m.scheduled_date||'—'}</td><td className="px-4 py-3 text-right">{money(m.price)}</td></tr>)}</tbody></table></div></div>{order.notes&&<div className="mt-5 rounded-xl bg-slate-50 p-4 text-sm text-slate-600">{order.notes}</div>}{order.cancellation_reason&&<div className="mt-4 rounded-xl border border-rose-100 bg-rose-50 p-4 text-sm text-rose-700"><b>Cancellation reason:</b> {order.cancellation_reason}</div>}{canCancel&&<div className="mt-6 border-t border-slate-100 pt-5"><label className="text-xs font-semibold text-slate-600">Cancellation reason<textarea value={reason} onChange={e=>setReason(e.target.value)} rows={3} placeholder="Minimum 5 characters" className="mt-1 w-full rounded-xl border border-slate-200 p-3 text-sm"/></label><div className="mt-3 flex justify-end"><button disabled={busy||reason.trim().length<5} onClick={onCancel} className="inline-flex items-center gap-2 rounded-lg bg-rose-700 px-4 py-2 text-xs font-semibold text-white disabled:opacity-40"><XCircle size={14}/>{busy?'Cancelling…':'Cancel order'}</button></div></div>}</div></div>}
function CreateOrder({customerId,meals,loading,busy,onClose,onSubmit}:any){const [ids,setIds]=useState<number[]>([]),[notes,setNotes]=useState('');const planned=meals.filter((m:any)=>m.status==='planned');return <div className="fixed inset-0 z-50 grid place-items-center bg-slate-950/35 p-4"><div className="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-6"><div className="flex justify-between"><h2 className="font-semibold">Create order · Customer #{customerId}</h2><button onClick={onClose}>×</button></div><div className="mt-5 rounded-xl border border-amber-100 bg-amber-50 p-3 text-xs text-amber-800"><AlertTriangle size={14} className="mr-1 inline"/>Only planned meals can be ordered. Laravel rechecks ownership and concurrent order eligibility.</div>{loading?<Loading/>:<div className="mt-4 space-y-2">{planned.map((m:any)=><label key={m.id} className="flex items-center gap-3 rounded-xl border border-slate-200 p-3"><input type="checkbox" checked={ids.includes(m.id)} onChange={e=>setIds(e.target.checked?[...ids,m.id]:ids.filter(x=>x!==m.id))}/><span className="text-sm font-medium">Meal #{m.id} · {m.meal_slot}</span><span className="ml-auto text-xs text-slate-400">{m.scheduled_date}</span></label>)}</div>}<textarea value={notes} onChange={e=>setNotes(e.target.value)} rows={3} placeholder="Notes (optional)" className="mt-4 w-full rounded-xl border border-slate-200 p-3 text-sm"/><div className="mt-4 flex justify-end gap-2"><button onClick={onClose} className="rounded-lg px-4 py-2 text-sm">Cancel</button><button disabled={busy||ids.length===0} onClick={()=>onSubmit({meal_ids:ids,notes:notes||null})} className="rounded-lg bg-slate-950 px-4 py-2 text-sm font-semibold text-white disabled:opacity-40">{busy?'Creating…':'Create order'}</button></div></div></div>}
function Stat({label,value}:any){return <div className="rounded-xl bg-slate-50 p-3"><div className="text-[10px] font-semibold uppercase tracking-wide text-slate-400">{label}</div><div className="mt-1 text-sm font-semibold text-slate-800">{value}</div></div>};function Pager({page,last,setPage}:any){return <div className="flex items-center justify-between border-t border-slate-100 px-5 py-3"><span className="text-xs text-slate-400">Page {page} of {last}</span><div className="flex gap-2"><button disabled={page<=1} onClick={()=>setPage(page-1)} className="rounded-lg border p-2 disabled:opacity-30"><ChevronLeft size={15}/></button><button disabled={page>=last} onClick={()=>setPage(page+1)} className="rounded-lg border p-2 disabled:opacity-30"><ChevronRight size={15}/></button></div></div>};function Empty({text}:any){return <div className="rounded-2xl border border-slate-200 bg-white p-12 text-center text-sm text-slate-400"><ClipboardList className="mx-auto text-slate-300" size={38}/><div className="mt-3">{text}</div></div>};function Loading(){return <div className="p-10 text-center text-sm text-slate-400">Loading…</div>};function Error({message}:any){return <div className="rounded-2xl border border-rose-100 bg-rose-50 p-10 text-center text-sm text-rose-700">{message}</div>}
