import { useAuthStore } from '../stores/authStore';

const badge=(s:string)=>s==='active'||s==='planned'?'border-emerald-100 bg-emerald-50 text-emerald-700':s==='pending_review'||s==='draft'?'border-amber-100 bg-amber-50 text-amber-700':s==='rejected'||s==='cancelled'?'border-rose-100 bg-rose-50 text-rose-700':'border-slate-200 bg-slate-50 text-slate-600';
const errorText=(e:any)=>e?.response?.data?.message||e?.response?.data?.error||Object.values(e?.response?.data?.errors||{})?.flat?.()?.[0]||'The request could not be completed.';
const money=(v:any)=>v==null?'—':`${Number(v).toFixed(2)} ETB`;

export default function Recipes(){
 const {user}=useAuthStore(); const role=user?.role; const canCreate=['super_admin','nutritionist','kitchen_operations'].includes(role||''); const canReview=['super_admin','nutritionist'].includes(role||'');
 const [tab,setTab]=useState<'recipes'|'meals'>('recipes'); const [page,setPage]=useState(1); const [customerId,setCustomerId]=useState(''); const [mealPage,setMealPage]=useState(1); const [selected,setSelected]=useState<number|null>(null); const [modal,setModal]=useState<'create'|'edit'|'revision'|'meal'|'reject'|null>(null); const [reason,setReason]=useState(''); const qc=useQueryClient();
 const recipes=useQuery({queryKey:['recipes',page],queryFn:()=>listRecipes(page),enabled:tab==='recipes'}); const ingredients=useQuery({queryKey:['recipe-ingredients'],queryFn:listIngredients,enabled:modal==='create'||modal==='edit'||modal==='revision'});
 const cid=Number(customerId); const meals=useQuery({queryKey:['meals',cid,mealPage],queryFn:()=>listMeals(cid,mealPage),enabled:tab==='meals'&&cid>0});
 const refresh=()=>{qc.invalidateQueries({queryKey:['recipes']}); if(cid>0)qc.invalidateQueries({queryKey:['meals',cid]})};
 const mutation=useMutation({mutationFn:async(x:any)=>{switch(x.action){case'create':return createRecipe(x.payload);case'update':return updateRecipe(x.id,x.payload);case'submit':return submitRecipe(x.id);case'approve':return approveRecipe(x.id);case'reject':return rejectRecipe(x.id,x.reason);case'meal':return createMeal(x.customerId,x.payload);case'cancel':return cancelMeal(x.id)}},onSuccess:()=>{setModal(null);setSelected(null);setReason('');refresh()}});
 const activeRecipe=selected?(recipes.data?.data||[]).find(r=>r.id===selected):null;
 return <div className="space-y-6">
  <header className="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between"><div><div className="mb-2 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] font-semibold uppercase tracking-[.14em] text-slate-600"><ShieldCheck size={13}/> Food operations</div><h1 className="text-2xl font-semibold tracking-tight text-slate-950">Recipes & Meals</h1><p className="mt-1 max-w-3xl text-sm leading-6 text-slate-500">Govern recipe versions and safety snapshots, then assign approved recipes to customer meals. Laravel remains authoritative for approvals and safety gates.</p></div><button onClick={()=>setModal(tab==='recipes'?'create':'meal')} disabled={tab==='recipes'?!canCreate:false} className="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-slate-950 px-4 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-40"><Plus size={16}/>{tab==='recipes'?'New recipe':'Assign meal'}</button></header>
  <div className="flex items-center justify-between border-b border-slate-200"><div className="flex gap-1"><Tab active={tab==='recipes'} onClick={()=>setTab('recipes')} icon={BookOpen}>Recipe governance</Tab><Tab active={tab==='meals'} onClick={()=>setTab('meals')} icon={Utensils}>Customer meals</Tab></div><button onClick={refresh} className="mb-2 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50"><RefreshCw size={14}/>Refresh</button></div>
  {tab==='recipes'?<RecipeWorkspace data={recipes.data} loading={recipes.isLoading} error={recipes.isError} page={page} setPage={setPage} selected={activeRecipe} onSelect={setSelected} canReview={canReview} mutation={mutation} setModal={setModal}/>:<MealWorkspace customerId={customerId} setCustomerId={setCustomerId} data={meals.data} loading={meals.isLoading} error={meals.isError} page={mealPage} setPage={setMealPage} mutation={mutation}/>} 
  {modal==='create'&&<RecipeForm title="Create recipe" ingredients={ingredients.data?.data||[]} busy={mutation.isPending} onClose={()=>setModal(null)} onSubmit={(payload:any)=>mutation.mutate({action:'create',payload})}/>} 
  {modal==='edit'&&activeRecipe&&<RecipeForm title={`Edit draft · v${activeRecipe.version}`} initial={activeRecipe} ingredients={ingredients.data?.data||[]} busy={mutation.isPending} onClose={()=>setModal(null)} onSubmit={(payload:any)=>mutation.mutate({action:'update',id:activeRecipe.id,payload})}/>} 
  {modal==='revision'&&activeRecipe&&<RecipeForm title={`New revision of ${activeRecipe.name}`} initial={activeRecipe} ingredients={ingredients.data?.data||[]} revision busy={mutation.isPending} onClose={()=>setModal(null)} onSubmit={(payload:any)=>mutation.mutate({action:'create',payload:{...payload,revises_recipe_id:activeRecipe.id}})}/>} 
  {modal==='meal'&&<MealForm recipes={(recipes.data?.data||[]).filter(r=>r.status==='active')} busy={mutation.isPending} onClose={()=>setModal(null)} onSubmit={(customerId:number,payload:{scheduled_date:string;meal_slot:string;recipes:{recipe_id:number;servings:number}[]})=>mutation.mutate({action:'meal',customerId,payload})}/>} 
  {modal==='reject'&&selected&&<RejectDialog busy={mutation.isPending} reason={reason} setReason={setReason} onClose={()=>{setModal(null);setReason('')}} onSubmit={()=>mutation.mutate({action:'reject',id:selected,reason:reason.trim()})}/>} 
  {mutation.isError&&<div className="fixed bottom-5 right-5 z-[60] max-w-sm rounded-xl border border-rose-200 bg-white p-4 shadow-xl"><div className="flex gap-3"><AlertTriangle className="mt-0.5 text-rose-600" size={18}/><div><div className="text-sm font-semibold text-slate-900">Action failed</div><div className="mt-1 text-xs leading-5 text-slate-500">{errorText(mutation.error)}</div></div></div></div>}
 </div>
}
function Tab({active,onClick,icon:Icon,children}:any){return <button onClick={onClick} className={`inline-flex items-center gap-2 border-b-2 px-4 py-3 text-sm font-semibold ${active?'border-slate-950 text-slate-950':'border-transparent text-slate-500 hover:text-slate-800'}`}><Icon size={16}/>{children}</button>}
function RecipeWorkspace({data,loading,error,page,setPage,selected,onSelect,canReview,mutation,setModal}:any){const rows=data?.data||[]; return <div className="grid gap-4 xl:grid-cols-[minmax(0,1fr)_390px]"> <section className="overflow-hidden rounded-2xl border border-slate-200 bg-white"><div className="flex items-center justify-between border-b border-slate-200 p-4"><div><h2 className="text-sm font-semibold">Recipe register</h2><p className="mt-1 text-xs text-slate-500">Versions, review state and frozen safety information.</p></div><span className="text-xs text-slate-400">{data?.meta.total??'—'} records</span></div>{loading?<Loading/>:error?<ErrorState/>:rows.length===0?<Empty icon={BookOpen} text="No recipes recorded yet."/>:<><div className="overflow-x-auto"><table className="w-full min-w-[800px] text-left text-sm"><thead className="bg-slate-50 text-[11px] uppercase tracking-wide text-slate-500"><tr><th className="px-5 py-3">Recipe</th><th className="px-5 py-3">Status</th><th className="px-5 py-3">Nutrition</th><th className="px-5 py-3">Price</th><th className="px-5 py-3">Safety</th></tr></thead><tbody className="divide-y divide-slate-100">{rows.map((r:Recipe)=><tr key={r.id} onClick={()=>onSelect(r.id)} className={`cursor-pointer transition hover:bg-slate-50 ${selected?.id===r.id?'bg-slate-50':''}`}><td className="px-5 py-4"><div className="font-semibold text-slate-900">{r.name}</div><div className="mt-1 text-xs text-slate-400">#{r.id} · v{r.version} · {r.ingredients?.length||0} ingredients</div></td><td className="px-5 py-4"><span className={`rounded-full border px-2.5 py-1 text-[11px] font-semibold ${badge(r.status)}`}>{r.status.replace('_',' ')}</span></td><td className="px-5 py-4 text-slate-600">{r.nutrition_per_serving?.calories??'—'} kcal</td><td className="px-5 py-4 text-slate-600">{money(r.price_per_serving)}</td><td className="px-5 py-4">{r.is_frozen_snapshot?<span className="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700"><LockKeyhole size={14}/>Frozen</span>:<span className="text-xs text-amber-700">Preview</span>}</td></tr>)}</tbody></table></div><Pager page={page} last={data.meta.last_page} setPage={setPage}/></>}</section><RecipeDetail recipe={selected} canReview={canReview} mutation={mutation} setModal={setModal}/></div>}
function RecipeDetail({recipe,canReview,mutation,setModal}:any){if(!recipe)return <aside className="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center"><BookOpen className="mx-auto text-slate-300" size={32}/><h2 className="mt-4 text-sm font-semibold">Select a recipe</h2><p className="mt-1 text-sm text-slate-500">Open a row to inspect ingredients, nutrition, allergens and review actions.</p></aside>; return <aside className="rounded-2xl border border-slate-200 bg-white p-5"><div className="flex items-start justify-between gap-3"><div><span className={`rounded-full border px-2 py-1 text-[11px] font-semibold ${badge(recipe.status)}`}>{recipe.status.replace('_',' ')}</span><h2 className="mt-3 text-lg font-semibold tracking-tight">{recipe.name}</h2><p className="mt-1 text-xs text-slate-400">Recipe #{recipe.id} · version {recipe.version}</p></div>{recipe.is_frozen_snapshot&&<LockKeyhole className="text-emerald-600" size={18}/>}</div><div className="mt-5 grid grid-cols-2 gap-2">{[['Calories',`${recipe.nutrition_per_serving?.calories??'—'} kcal`],['Protein',`${recipe.nutrition_per_serving?.protein_g??'—'} g`],['Carbs',`${recipe.nutrition_per_serving?.carbs_g??'—'} g`],['Fat',`${recipe.nutrition_per_serving?.fat_g??'—'} g`]].map(([a,b])=><div key={a} className="rounded-lg bg-slate-50 p-3"><div className="text-[10px] font-semibold uppercase tracking-wide text-slate-400">{a}</div><div className="mt-1 text-sm font-semibold">{b}</div></div>)}</div><Section title="Ingredients"><div className="space-y-2">{recipe.ingredients?.map((i:any)=><div key={i.ingredient_id} className="flex items-center justify-between text-sm"><span className="text-slate-700">{i.name}</span><span className="text-xs text-slate-400">{i.quantity} {i.unit_of_measure}</span></div>)}</div></Section><Section title="Allergens"><div className="flex flex-wrap gap-2">{recipe.allergens?.length?recipe.allergens.map((a:any)=><span key={a.id} className="rounded-full border border-rose-100 bg-rose-50 px-2.5 py-1 text-xs font-medium text-rose-700">{a.name}</span>):<span className="text-sm text-slate-400">No allergens recorded.</span>}</div></Section>{recipe.rejection_reason&&<div className="rounded-lg border border-rose-100 bg-rose-50 p-3 text-xs leading-5 text-rose-700"><strong>Review reason:</strong> {recipe.rejection_reason}</div>}<div className="mt-5 flex flex-wrap gap-2">{recipe.status==='draft'&&<><button onClick={()=>setModal('edit')} className="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold"><FilePenLine size={14}/>Edit</button><button onClick={()=>mutation.mutate({action:'submit',id:recipe.id})} disabled={mutation.isPending} className="rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white">Submit for review</button></>}{recipe.status==='active'&&<button onClick={()=>setModal('revision')} className="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold"><Plus size={14}/>Create revision</button>}{recipe.status==='pending_review'&&canReview&&<><button disabled={mutation.isPending} onClick={()=>mutation.mutate({action:'approve',id:recipe.id})} className="inline-flex items-center gap-2 rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white"><CheckCircle2 size={14}/>Approve</button><button disabled={mutation.isPending} onClick={()=>setModal('reject')} className="inline-flex items-center gap-2 rounded-lg border border-rose-200 px-3 py-2 text-xs font-semibold text-rose-700"><XCircle size={14}/>Reject</button></>}</div></aside>}
function Section({title,children}:any){return <div className="mt-5 border-t border-slate-100 pt-5"><h3 className="mb-3 text-[11px] font-semibold uppercase tracking-[.12em] text-slate-400">{title}</h3>{children}</div>}
function Loading(){return <div className="space-y-px">{Array.from({length:6}).map((_,i)=><div key={i} className="h-16 animate-pulse bg-slate-50"/>)}</div>}
function Empty({icon:Icon,text}:any){return <div className="grid min-h-72 place-items-center p-8 text-center"><div><Icon className="mx-auto text-slate-300" size={30}/><div className="mt-3 text-sm font-semibold text-slate-700">{text}</div></div></div>}
function ErrorState(){return <div className="grid min-h-72 place-items-center p-8 text-center"><div><AlertTriangle className="mx-auto text-rose-400" size={30}/><div className="mt-3 text-sm font-semibold">Could not load recipes</div><div className="mt-1 text-xs text-slate-500">Check the Laravel API connection and authentication.</div></div></div>}
function Pager({page,last,setPage}:any){return <div className="flex items-center justify-between border-t border-slate-200 px-4 py-3"><span className="text-xs text-slate-400">Page {page} of {last}</span><div className="flex gap-2"><button disabled={page<=1} onClick={()=>setPage(page-1)} className="rounded-lg border border-slate-200 p-2 disabled:opacity-40"><ChevronLeft size={15}/></button><button disabled={page>=last} onClick={()=>setPage(page+1)} className="rounded-lg border border-slate-200 p-2 disabled:opacity-40"><ChevronRight size={15}/></button></div></div>}
function RecipeForm({title,initial,ingredients,revision,busy,onClose,onSubmit}:any){const [name,setName]=useState(initial?.name||'');const [description,setDescription]=useState(initial?.description||'');const [instructions,setInstructions]=useState(initial?.instructions||'');const [servings,setServings]=useState(String(initial?.servings||1));const [price,setPrice]=useState(initial?.price_per_serving==null?'':String(initial.price_per_serving));const [rows,setRows]=useState<any[]>(initial?.ingredients?.map((i:any)=>({ingredient_id:String(i.ingredient_id),quantity:String(i.quantity)}))||[{ingredient_id:'',quantity:''}]);const add=()=>setRows([...rows,{ingredient_id:'',quantity:''}]);const updateRow=(i:number,k:string,v:string)=>setRows(rows.map((r,idx)=>idx===i?{...r,[k]:v}:r)); return <Modal title={title} onClose={onClose}><div className="grid gap-4"><Input label="Recipe name" value={name} onChange={setName}/><div className="grid gap-4 sm:grid-cols-2"><Input label="Servings" value={servings} onChange={setServings} type="number"/><Input label="Price / serving (ETB)" value={price} onChange={setPrice} type="number"/></div><TextArea label="Description" value={description} onChange={setDescription}/><TextArea label="Instructions" value={instructions} onChange={setInstructions} rows={5}/><div><div className="mb-2 text-xs font-semibold text-slate-600">Ingredients</div><div className="space-y-2">{rows.map((r,i)=><div key={i} className="grid grid-cols-[1fr_110px_34px] gap-2"><select value={r.ingredient_id} onChange={e=>updateRow(i,'ingredient_id',e.target.value)} className="h-10 rounded-lg border border-slate-200 bg-white px-3 text-sm"><option value="">Select approved ingredient</option>{ingredients.filter((x:any)=>x.status==='approved').map((x:any)=><option key={x.id} value={x.id}>{x.name} · {x.unit_of_measure}</option>)}</select><input value={r.quantity} onChange={e=>updateRow(i,'quantity',e.target.value)} type="number" min="0.01" step="0.01" placeholder="Quantity" className="h-10 rounded-lg border border-slate-200 px-3 text-sm"/><button type="button" disabled={rows.length===1} onClick={()=>setRows(rows.filter((_,idx)=>idx!==i))} className="rounded-lg border border-slate-200 text-slate-400 disabled:opacity-30">×</button></div>)}</div><button type="button" onClick={add} className="mt-2 text-xs font-semibold text-slate-700 hover:underline">+ Add ingredient</button></div></div><div className="flex justify-end gap-2 pt-2"><button onClick={onClose} className="rounded-lg px-4 py-2 text-sm font-medium text-slate-600">Cancel</button><button disabled={busy||!name.trim()||rows.some(r=>!r.ingredient_id||Number(r.quantity)<=0)} onClick={()=>onSubmit({name:name.trim(),description:description||null,instructions:instructions||null,servings:Number(servings),price_per_serving:price===''?null:Number(price),ingredients:rows.map(r=>({ingredient_id:Number(r.ingredient_id),quantity:Number(r.quantity)}))})} className="rounded-lg bg-slate-950 px-4 py-2 text-sm font-semibold text-white disabled:opacity-40">{busy?'Saving…':revision?'Create revision':'Save recipe'}</button></div></Modal>}
function MealWorkspace({customerId,setCustomerId,data,loading,error,page,setPage,mutation}:any){return <div className="space-y-4"><section className="rounded-2xl border border-slate-200 bg-white p-4"><div className="flex flex-col gap-3 md:flex-row md:items-end"><div className="flex-1"><label className="text-xs font-semibold text-slate-600">Customer ID</label><input value={customerId} onChange={e=>{setCustomerId(e.target.value.replace(/\D/g,''));setPage(1)}} placeholder="Enter customer ID to load meals" inputMode="numeric" className="mt-1 h-10 w-full max-w-sm rounded-lg border border-slate-200 px-3 text-sm outline-none focus:border-slate-400"/></div><div className="inline-flex items-center gap-2 text-xs text-slate-500"><ShieldCheck size={15}/> Only active recipes can be assigned; Laravel performs the safety gate.</div></div></section>{!customerId?<Empty icon={Utensils} text="Enter a customer ID to inspect meals."/>:loading?<Loading/>:error?<ErrorState/>:!data?.data?.length?<Empty icon={Utensils} text="No meals recorded for this customer."/>:<section className="overflow-hidden rounded-2xl border border-slate-200 bg-white"><div className="overflow-x-auto"><table className="w-full min-w-[760px] text-left text-sm"><thead className="bg-slate-50 text-[11px] uppercase tracking-wide text-slate-500"><tr><th className="px-5 py-3">Meal</th><th className="px-5 py-3">Scheduled</th><th className="px-5 py-3">Recipes</th><th className="px-5 py-3">Status</th><th className="px-5 py-3 text-right">Action</th></tr></thead><tbody className="divide-y divide-slate-100">{data.data.map((m:Meal)=><tr key={m.id}><td className="px-5 py-4"><div className="font-semibold">Meal #{m.id}</div><div className="text-xs text-slate-400">Customer #{m.customer_id} · {m.meal_slot}</div></td><td className="px-5 py-4 text-slate-600">{m.scheduled_date}</td><td className="px-5 py-4"><div className="space-y-1">{m.recipes.map(r=><div key={r.recipe_id} className="text-sm text-slate-700">{r.name} <span className="text-xs text-slate-400">× {r.servings}</span></div>)}</div></td><td className="px-5 py-4"><span className={`rounded-full border px-2.5 py-1 text-[11px] font-semibold ${badge(m.status)}`}>{m.status}</span></td><td className="px-5 py-4 text-right">{m.status==='planned'&&<button disabled={mutation.isPending} onClick={()=>mutation.mutate({action:'cancel',id:m.id})} className="rounded-lg border border-rose-200 px-3 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-50">Cancel</button>}</td></tr>)}</tbody></table></div><Pager page={page} last={data.meta.last_page} setPage={setPage}/></section>}</div>}
function MealForm({recipes,busy,onClose,onSubmit}:any){const [customer,setCustomer]=useState('');const [date,setDate]=useState('');const [slot,setSlot]=useState('breakfast');const [recipe,setRecipe]=useState('');const [servings,setServings]=useState('1');return <Modal title="Assign customer meal" onClose={onClose}><div className="grid gap-4"><Input label="Customer ID" value={customer} onChange={setCustomer} type="number"/><div className="grid gap-4 sm:grid-cols-2"><Input label="Scheduled date" value={date} onChange={setDate} type="date"/><div><label className="text-xs font-semibold text-slate-600">Meal slot</label><select value={slot} onChange={e=>setSlot(e.target.value)} className="mt-1 h-10 w-full rounded-lg border border-slate-200 px-3 text-sm"><option>breakfast</option><option>lunch</option><option>dinner</option><option>snack</option></select></div></div><div><label className="text-xs font-semibold text-slate-600">Active recipe</label><select value={recipe} onChange={e=>setRecipe(e.target.value)} className="mt-1 h-10 w-full rounded-lg border border-slate-200 px-3 text-sm"><option value="">Select active recipe</option>{recipes.map((r:any)=><option key={r.id} value={r.id}>{r.name} · v{r.version}</option>)}</select></div><Input label="Servings" value={servings} onChange={setServings} type="number"/><div className="rounded-lg border border-amber-100 bg-amber-50 p-3 text-xs leading-5 text-amber-800">Assignment is safety-sensitive. Pending customer safety records or approved allergen conflicts will be blocked by Laravel.</div><div className="flex justify-end gap-2"><button onClick={onClose} className="rounded-lg px-4 py-2 text-sm text-slate-600">Cancel</button><button disabled={busy||!customer||!date||!recipe||Number(servings)<=0} onClick={()=>onSubmit(Number(customer),{scheduled_date:date,meal_slot:slot,recipes:[{recipe_id:Number(recipe),servings:Number(servings)}]})} className="rounded-lg bg-slate-950 px-4 py-2 text-sm font-semibold text-white disabled:opacity-40">{busy?'Assigning…':'Assign meal'}</button></div></div></Modal>}
function RejectDialog({busy,reason,setReason,onClose,onSubmit}:any){return <Modal title="Reject recipe" onClose={onClose}><p className="text-sm text-slate-500">A review reason is required and is stored by Laravel with the authoritative rejection.</p><textarea value={reason} onChange={e=>setReason(e.target.value)} rows={5} className="mt-4 w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-slate-400" placeholder="Explain what must change before approval…"/><div className="mt-4 flex justify-end gap-2"><button onClick={onClose} className="rounded-lg px-4 py-2 text-sm text-slate-600">Cancel</button><button disabled={busy||reason.trim().length<5} onClick={onSubmit} className="rounded-lg bg-rose-700 px-4 py-2 text-sm font-semibold text-white disabled:opacity-40">{busy?'Rejecting…':'Reject recipe'}</button></div></Modal>}
function Modal({title,onClose,children}:any){return <div className="fixed inset-0 z-50 grid place-items-center bg-slate-950/35 p-4"><div className="max-h-[92vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl"><div className="mb-5 flex items-center justify-between"><h2 className="text-base font-semibold text-slate-950">{title}</h2><button onClick={onClose} className="rounded-lg p-2 text-slate-400 hover:bg-slate-100">×</button></div>{children}</div></div>}
function Input({label,value,onChange,type='text'}:any){return <div><label className="text-xs font-semibold text-slate-600">{label}</label><input value={value} onChange={e=>onChange(e.target.value)} type={type} className="mt-1 h-10 w-full rounded-lg border border-slate-200 px-3 text-sm outline-none focus:border-slate-400"/></div>}
function TextArea({label,value,onChange,rows=3}:any){return <div><label className="text-xs font-semibold text-slate-600">{label}</label><textarea value={value} onChange={e=>onChange(e.target.value)} rows={rows} className="mt-1 w-full rounded-lg border border-slate-200 p-3 text-sm outline-none focus:border-slate-400"/></div>}
